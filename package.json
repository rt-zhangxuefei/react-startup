{
  "name": "react-startup",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "craco start",
    "build:beta": "dotenv -e .env.beta craco build",
    "build:prod": "dotenv -e .env.prod craco build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@reduxjs/toolkit": "^2.8.2",
    "antd": "^5.26.0",
    "axios": "^1.9.0",
    "bytes": "^3.1.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-contextmenu-lite": "^1.0.13",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.2",
    "redux-saga": "^1.3.0",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@types/node": "^22.15.31",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "craco-less": "^3.0.1",
    "dotenv-cli": "^8.0.0",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,less,md}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults"
  ]
}
